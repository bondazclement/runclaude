# ─── jupyter ──────────────────────────────────────────────────────────

def cmd_jupyter(args):
    """Jupyter operations."""
    try:
        subcmd = args.jupyter_subcmd

        if subcmd == "kernels":
            stdout, stderr, rc = run_cmd("jupyter kernelspec list --json 2>/dev/null || echo '{}'")
            try:
                kernels = json.loads(stdout)
            except json.JSONDecodeError:
                kernels = {"raw": stdout}

            # Also get running kernels via API
            api_out, _, _ = run_cmd("curl -s http://localhost:8888/api/kernels 2>/dev/null || echo '[]'")
            try:
                running = json.loads(api_out)
            except json.JSONDecodeError:
                running = []

            json_output({"type": "jupyter_kernels", "specs": kernels, "running": running})

        elif subcmd == "outputs":
            kernel_id = args.kernel_id
            count = int(args.count or 20)
            lines = _read_stream_all()
            filtered = [l for l in lines if "jupyter" in l.get("source", "") and kernel_id in l.get("kernel_id", "")]
            json_output({"type": "jupyter_outputs", "kernel_id": kernel_id, "count": len(filtered[-count:]), "entries": filtered[-count:]})

        else:
            json_error(f"Unknown jupyter subcommand: {subcmd}")
    except Exception as e:
        json_output({"error": str(e), "command": "jupyter",
                     "partial": True, "ts": int(time.time())})


# ─── Helpers ──────────────────────────────────────────────────────────

def _get_gpu_info():
    """Get GPU info via nvidia-smi."""
    stdout, _, rc = run_cmd(
        "nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu "
        "--format=csv,noheader,nounits 2>/dev/null",
        timeout=5,
    )
    if rc != 0 or not stdout:
        return None

    gpus = []
    for line in stdout.strip().split("\n"):
        parts = [p.strip() for p in line.split(",")]
        if len(parts) >= 6:
            gpus.append({
                "index": int(parts[0]),
                "name": parts[1],
                "util_pct": int(parts[2]),
                "mem_used_mb": int(parts[3]),
                "mem_total_mb": int(parts[4]),
                "temp_c": int(parts[5]),
            })
    return gpus if gpus else None


def _get_services_status():
    """Check status of managed services."""
    services = {}

    # logd
    logd_pid_file = Path(f"{PIDS_DIR}/logd.pid")
    if logd_pid_file.exists():
        try:
            pid = int(logd_pid_file.read_text().strip())
            alive = os.path.exists(f"/proc/{pid}")
            services["logd"] = {"pid": pid, "alive": alive}
        except (ValueError, OSError):
            services["logd"] = {"pid": None, "alive": False}
    else:
        services["logd"] = {"pid": None, "alive": False}

    # sshd claude (port 2222)
    stdout, _, _ = run_cmd("pgrep -f 'sshd.*sshd_claude' | head -1")
    if stdout:
        services["sshd_claude"] = {"pid": int(stdout), "alive": True}
    else:
        services["sshd_claude"] = {"pid": None, "alive": False}

    return services


def _parse_duration(s):
    """Parse duration string like '5m', '1h', '30s' to seconds."""
    s = s.strip().lower()
    if s.endswith("s"):
        return int(s[:-1])
    elif s.endswith("m"):
        return int(s[:-1]) * 60
    elif s.endswith("h"):
        return int(s[:-1]) * 3600
    elif s.endswith("d"):
        return int(s[:-1]) * 86400
    else:
        try:
            return int(s)
        except ValueError:
            return 300  # default 5m


def _read_stream_since(cutoff_ts):
    """Read stream.jsonl entries since cutoff timestamp."""
    entries = []
    stream_path = Path(STREAM_FILE)
    if not stream_path.exists():
        return entries

    # Read from end for efficiency
    lines = _tail_file(STREAM_FILE, 5000)
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
            if entry.get("ts", 0) >= cutoff_ts:
                entries.append(entry)
        except json.JSONDecodeError:
            continue

    return entries


def _read_stream_all():
    """Read all stream.jsonl entries."""
    entries = []
    stream_path = Path(STREAM_FILE)
    if not stream_path.exists():
        return entries

    with open(STREAM_FILE, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    return entries


def _tail_file(filepath, n):
    """Read last n lines of a file efficiently."""
    try:
        stdout, _, _ = run_cmd(f"tail -n {n} '{filepath}'", timeout=5)
        return stdout.split("\n") if stdout else []
    except Exception:
        return []


# ─── Main ─────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="podctl",
        description="CLI pour Claude Code sur pod RunPod. Toutes les sorties sont en JSON.",
    )
    subparsers = parser.add_subparsers(dest="command", help="Commande")

    # status
    subparsers.add_parser("status", help="Snapshot global du pod")

    # health
    subparsers.add_parser("health", help="Health check binaire")

    # watch
    watch_parser = subparsers.add_parser("watch", help="Boucle de polling")
    watch_parser.add_argument("interval", nargs="?", default="30", help="Intervalle en secondes (défaut: 30)")

    # logs
    logs_parser = subparsers.add_parser("logs", help="Logs filtrés")
    logs_sub = logs_parser.add_subparsers(dest="logs_subcmd")

    recent = logs_sub.add_parser("recent", help="Logs récents")
    recent.add_argument("duration", nargs="?", default="5m", help="Durée (ex: 5m, 1h)")

    filt = logs_sub.add_parser("filter", help="Filtrer par niveau")
    filt.add_argument("level", help="Niveau (error, warning, info)")
    filt.add_argument("duration", nargs="?", default="1h", help="Durée")

    search = logs_sub.add_parser("search", help="Recherche par pattern")
    search.add_argument("pattern", help="Regex pattern")
    search.add_argument("duration", nargs="?", default="30m", help="Durée")

    kernel = logs_sub.add_parser("kernel", help="Logs d'un kernel Jupyter")
    kernel.add_argument("kernel_id", help="ID du kernel (8 premiers chars)")
    kernel.add_argument("count", nargs="?", default="20", help="Nombre de lignes")

    # ps
    subparsers.add_parser("ps", help="Processus actifs")

    # gpu
    subparsers.add_parser("gpu", help="État GPU")

    # exec
    exec_parser = subparsers.add_parser("exec", help="Exécuter une commande")
    exec_parser.add_argument("command", help="Commande à exécuter")
    exec_parser.add_argument("--timeout", default="30", help="Timeout en secondes")

    # summary
    subparsers.add_parser("summary", help="Résumé compact (<300 tokens)")

    # jupyter
    jupyter_parser = subparsers.add_parser("jupyter", help="Jupyter operations")
    jupyter_sub = jupyter_parser.add_subparsers(dest="jupyter_subcmd")

    jupyter_sub.add_parser("kernels", help="Lister les kernels")

    outputs = jupyter_sub.add_parser("outputs", help="Outputs d'un kernel")
    outputs.add_argument("kernel_id", help="ID du kernel")
    outputs.add_argument("count", nargs="?", default="20", help="Nombre d'outputs")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "status": cmd_status,
        "health": cmd_health,
        "watch": cmd_watch,
        "logs": cmd_logs,
        "ps": cmd_ps,
        "gpu": cmd_gpu,
        "exec": cmd_exec,
        "summary": cmd_summary,
        "jupyter": cmd_jupyter,
    }

    handler = commands.get(args.command)
    if handler:
        handler(args)
    else:
        json_error(f"Unknown command: {args.command}")


if __name__ == "__main__":
    main()
