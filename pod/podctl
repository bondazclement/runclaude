#!/usr/bin/env python3
"""podctl — CLI JSON pour pods RunPod."""

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

WORKSPACE_DIR = os.environ.get("WORKSPACE_DIR", "/workspace")
CLAUDE_DIR = os.path.join(WORKSPACE_DIR, "claude")
PIDS_DIR = os.path.join(WORKSPACE_DIR, "pids")
STREAM_FILE = os.path.join(CLAUDE_DIR, "stream.jsonl")

running_watch = True


def _stop_watch(_sig, _frame):
    global running_watch
    running_watch = False


def emit(payload):
    print(json.dumps(payload, ensure_ascii=False))


def json_error(message, command=None, partial=False):
    emit({"error": message, "command": command, "partial": partial, "ts": int(time.time())})


def run_cmd(command, timeout=10):
    try:
        proc = subprocess.run(command, shell=isinstance(command, str), capture_output=True, text=True, timeout=timeout)
        return proc.stdout.strip(), proc.stderr.strip(), proc.returncode
    except subprocess.TimeoutExpired:
        return "", "timeout", 124
    except Exception as exc:
        return "", str(exc), 1


def get_psutil():
    try:
        import psutil
        return psutil
    except Exception:
        return None


def get_services_status():
    services = {"logd": {"alive": False, "pid": None}, "sshd_claude": {"alive": False, "pid": None}}
    pid_file = Path(PIDS_DIR) / "logd.pid"
    if pid_file.exists():
        try:
            pid = int(pid_file.read_text().strip())
            services["logd"] = {"alive": Path(f"/proc/{pid}").exists(), "pid": pid}
        except Exception:
            pass

    out, _, rc = run_cmd("pgrep -f 'sshd.*sshd_claude_config' | head -1", timeout=5)
    if rc == 0 and out:
        services["sshd_claude"] = {"alive": True, "pid": int(out)}
    return services


def read_stream_last(n=2000):
    p = Path(STREAM_FILE)
    if not p.exists():
        return []
    out, _, rc = run_cmd(f"tail -n {int(n)} '{STREAM_FILE}'", timeout=5)
    if rc != 0:
        return []
    entries = []
    for line in out.splitlines():
        try:
            entries.append(json.loads(line))
        except Exception:
            continue
    return entries


def cmd_status(_args):
    try:
        psutil = get_psutil()
        mem = disk = cpu = None
        unavailable_reason = None
        if psutil:
            mem_obj = psutil.virtual_memory()
            disk_obj = psutil.disk_usage(WORKSPACE_DIR if os.path.isdir(WORKSPACE_DIR) else "/")
            mem = {"used_mb": int(mem_obj.used / 1024 / 1024), "total_mb": int(mem_obj.total / 1024 / 1024), "pct": mem_obj.percent}
            disk = {"free_gb": round(disk_obj.free / 1024**3, 2), "total_gb": round(disk_obj.total / 1024**3, 2), "pct": disk_obj.percent}
            cpu = {"pct": psutil.cpu_percent(interval=0.2)}
        else:
            unavailable_reason = "psutil not installed"

        emit({
            "type": "status",
            "ts": int(time.time()),
            "services": get_services_status(),
            "mem": mem,
            "disk": disk,
            "cpu": cpu,
            "unavailable_reason": unavailable_reason,
        })
    except Exception as exc:
        json_error(str(exc), command="status", partial=True)


def cmd_ps(_args):
    try:
        psutil = get_psutil()
        if not psutil:
            json_error("psutil not installed", command="ps", partial=True)
            return
        procs = []
        for p in psutil.process_iter(["pid", "name", "cpu_percent", "memory_info"]):
            try:
                mi = p.info.get("memory_info")
                procs.append({
                    "pid": p.info.get("pid"),
                    "name": p.info.get("name"),
                    "cpu_pct": p.info.get("cpu_percent", 0.0),
                    "mem_mb": round((mi.rss if mi else 0) / 1024 / 1024, 2),
                })
            except Exception:
                continue
        emit({"type": "ps", "ts": int(time.time()), "processes": sorted(procs, key=lambda x: x.get("cpu_pct", 0), reverse=True)[:100]})
    except Exception as exc:
        json_error(str(exc), command="ps", partial=True)


def cmd_gpu(_args):
    try:
        out, err, rc = run_cmd("nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits", timeout=5)
        if rc != 0:
            emit({"type": "gpu", "ts": int(time.time()), "gpus": None, "unavailable_reason": err or "nvidia-smi not available"})
            return
        gpus = []
        for line in out.splitlines():
            try:
                i, n, u, mu, mt, t = [x.strip() for x in line.split(",")]
                gpus.append({"index": int(i), "name": n, "util_pct": int(u), "mem_used_mb": int(mu), "mem_total_mb": int(mt), "temp_c": int(t)})
            except Exception:
                continue
        emit({"type": "gpu", "ts": int(time.time()), "gpus": gpus})
    except Exception as exc:
        json_error(str(exc), command="gpu", partial=True)


def cmd_exec(args):
    try:
        timeout = int(args.timeout)
        out, err, rc = run_cmd(args.command, timeout=timeout)
        emit({"type": "exec", "ts": int(time.time()), "command": args.command, "rc": rc, "stdout": out, "stderr": err})
    except Exception as exc:
        json_error(str(exc), command="exec")


def _parse_duration(s):
    m = re.match(r"^(\d+)([smhd]?)$", s.strip().lower())
    if not m:
        return 300
    val = int(m.group(1))
    unit = m.group(2) or "s"
    return val * {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]


def cmd_logs(args):
    try:
        entries = read_stream_last(5000)
        now = int(time.time())
        result = []
        sub = args.logs_subcmd

        if sub == "recent":
            cutoff = now - _parse_duration(args.duration)
            result = [e for e in entries if e.get("ts", 0) >= cutoff]
        elif sub == "filter":
            cutoff = now - _parse_duration(args.duration)
            level = args.level.lower()
            result = [e for e in entries if e.get("ts", 0) >= cutoff and str(e.get("level", "")).lower() == level]
        elif sub == "search":
            cutoff = now - _parse_duration(args.duration)
            pat = re.compile(args.pattern, re.IGNORECASE)
            result = [e for e in entries if e.get("ts", 0) >= cutoff and pat.search(json.dumps(e, ensure_ascii=False))]
        elif sub == "kernel":
            kid = args.kernel_id
            count = int(args.count)
            result = [e for e in entries if kid in json.dumps(e, ensure_ascii=False)][-count:]
        else:
            json_error("logs subcommand required", command="logs")
            return

        emit({"type": "logs", "subcommand": sub, "ts": now, "count": len(result), "entries": result[-200:]})
    except Exception as exc:
        json_error(str(exc), command="logs", partial=True)


def cmd_jupyter(args):
    try:
        if args.jupyter_subcmd == "kernels":
            out, err, rc = run_cmd("jupyter server list --json 2>/dev/null", timeout=5)
            emit({"type": "jupyter", "subcommand": "kernels", "ts": int(time.time()), "rc": rc, "stdout": out, "stderr": err})
            return
        if args.jupyter_subcmd == "outputs":
            entries = read_stream_last(4000)
            kid = args.kernel_id
            count = int(args.count)
            out_entries = [e for e in entries if e.get("source") == "jupyter.output" and kid in json.dumps(e)][-count:]
            emit({"type": "jupyter", "subcommand": "outputs", "ts": int(time.time()), "kernel_id": kid, "count": len(out_entries), "entries": out_entries})
            return
        json_error("unknown jupyter subcommand", command="jupyter")
    except Exception as exc:
        json_error(str(exc), command="jupyter", partial=True)


def cmd_summary(_args):
    try:
        services = get_services_status()
        gpu_out, gpu_err, gpu_rc = run_cmd("nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits", timeout=5)
        gpu = []
        if gpu_rc == 0 and gpu_out:
            for line in gpu_out.splitlines()[:2]:
                try:
                    u, mu, mt = [x.strip() for x in line.split(",")]
                    gpu.append({"util_pct": int(u), "mem_used_mb": int(mu), "mem_total_mb": int(mt)})
                except Exception:
                    continue

        entries = read_stream_last(200)
        alerts = [e for e in entries if str(e.get("level", "")).upper() in {"ERROR", "WARNING"}][-10:]
        emit({"type": "summary", "ts": int(time.time()), "services": services, "gpu": gpu if gpu else None, "alerts": alerts})
    except Exception as exc:
        json_error(str(exc), command="summary", partial=True)


def cmd_health(_args):
    try:
        checks = {}
        critical = []
        warnings = []

        services = get_services_status()
        checks["logd_alive"] = bool(services["logd"]["alive"])
        checks["sshd_claude_alive"] = bool(services["sshd_claude"]["alive"])

        stream_path = Path(STREAM_FILE)
        checks["stream_file_exists"] = stream_path.exists()
        if stream_path.exists():
            age = time.time() - stream_path.stat().st_mtime
            checks["stream_recently_written"] = age < 30
        else:
            checks["stream_recently_written"] = False

        total, used, free = shutil.disk_usage(WORKSPACE_DIR if os.path.isdir(WORKSPACE_DIR) else "/")
        checks["disk_not_critical"] = free > 5 * 1024**3

        _, err, rc = run_cmd("nvidia-smi -L", timeout=5)
        if rc == 0:
            checks["gpu_accessible"] = True
        elif "not found" in (err or ""):
            checks["gpu_accessible"] = None
            warnings.append("GPU non détecté (nvidia-smi absent)")
        else:
            checks["gpu_accessible"] = False

        if not checks["logd_alive"]:
            critical.append("logd mort — relancer /workspace/start.sh")
        if not checks["sshd_claude_alive"]:
            critical.append("sshd Claude arrêté — relancer /workspace/start.sh")
        if not checks["stream_file_exists"]:
            critical.append("stream.jsonl absent — vérifier /workspace/claude")
        if not checks["stream_recently_written"]:
            critical.append("stream.jsonl non mis à jour depuis >30s")
        if not checks["disk_not_critical"]:
            critical.append("espace disque critique (<5GB libres)")
        if checks["gpu_accessible"] is False:
            critical.append("GPU inaccessible — vérifier driver NVIDIA")

        emit({
            "type": "health",
            "ts": int(time.time()),
            "healthy": len(critical) == 0,
            "checks": checks,
            "warnings": warnings,
            "critical": critical,
        })
    except Exception as exc:
        json_error(str(exc), command="health", partial=True)


def cmd_watch(args):
    signal.signal(signal.SIGINT, _stop_watch)
    signal.signal(signal.SIGTERM, _stop_watch)
    interval = int(args.interval)
    cycle = 0
    while running_watch:
        cycle += 1
        services = get_services_status()
        entries = read_stream_last(80)
        alerts = [e for e in entries if str(e.get("level", "")).upper() in {"ERROR", "WARNING"}][-5:]
        emit({"type": "summary", "cycle": cycle, "ts": int(time.time()), "services": services, "alerts": alerts})
        time.sleep(max(1, interval))


def main():
    parser = argparse.ArgumentParser(prog="podctl", description="CLI JSON RunPod")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("status")

    logs = sub.add_parser("logs")
    logs_sub = logs.add_subparsers(dest="logs_subcmd")
    r = logs_sub.add_parser("recent")
    r.add_argument("duration", nargs="?", default="5m")
    f = logs_sub.add_parser("filter")
    f.add_argument("level")
    f.add_argument("duration", nargs="?", default="1h")
    s = logs_sub.add_parser("search")
    s.add_argument("pattern")
    s.add_argument("duration", nargs="?", default="30m")
    k = logs_sub.add_parser("kernel")
    k.add_argument("kernel_id")
    k.add_argument("count", nargs="?", default="20")

    sub.add_parser("ps")
    sub.add_parser("gpu")
    ex = sub.add_parser("exec")
    ex.add_argument("command")
    ex.add_argument("--timeout", default="30")
    sub.add_parser("summary")
    sub.add_parser("health")
    w = sub.add_parser("watch")
    w.add_argument("interval", nargs="?", default="30")

    j = sub.add_parser("jupyter")
    j_sub = j.add_subparsers(dest="jupyter_subcmd")
    j_sub.add_parser("kernels")
    jo = j_sub.add_parser("outputs")
    jo.add_argument("kernel_id")
    jo.add_argument("count", nargs="?", default="20")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1

    handlers = {
        "status": cmd_status,
        "logs": cmd_logs,
        "ps": cmd_ps,
        "gpu": cmd_gpu,
        "exec": cmd_exec,
        "summary": cmd_summary,
        "health": cmd_health,
        "watch": cmd_watch,
        "jupyter": cmd_jupyter,
    }
    try:
        handlers[args.command](args)
    except Exception as exc:
        json_error(str(exc), command=args.command)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
